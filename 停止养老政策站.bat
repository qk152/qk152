@echo off
rem ==========================================================================
rem  养老政策站 · 停止脚本
rem  按端口精确结束进程：8000（局域网发布服务）、8765（政策更新服务）
rem  只结束监听这两个端口的进程，不影响其他 Python 程序
rem ==========================================================================
setlocal
cd /d "%~dp0"

echo.
call :kill_port 8000 "局域网发布服务"
call :kill_port 8765 "政策更新服务"
echo.
echo  提示：局域网发布服务也可以直接关闭它的窗口来停止。
echo.
ping -n 3 127.0.0.1 >nul
exit /b 0

rem --------------------------------------------------------------------------
rem  结束监听指定端口的进程
rem  %1 = 端口号    %2 = 服务名称（仅用于提示文字）
rem --------------------------------------------------------------------------
:kill_port
set "PID="
for /f "tokens=2,5" %%A in ('netstat -ano ^| findstr /c:"LISTENING"') do (
  if "%%A"=="0.0.0.0:%~1" set "PID=%%B"
  if "%%A"=="127.0.0.1:%~1" set "PID=%%B"
  if "%%A"=="[::]:%~1" set "PID=%%B"
  if "%%A"=="[::1]:%~1" set "PID=%%B"
)
if not defined PID (
  echo   [提示] 端口 %~1 当前没有服务在运行。
  exit /b 0
)
taskkill /f /pid %PID% >nul 2>nul
if errorlevel 1 (
  echo   [提示] 端口 %~1 的进程 %PID% 结束失败，请手动关闭它的窗口。
) else (
  echo   [完成] 已停止端口 %~1 上的 %~2（进程 %PID%）。
)
exit /b 0
